# Farmer-facing API. MUST be a role without BYPASSRLS.
DATABASE_URL=postgres://app_login:devpass@localhost:5433/rabbitry

# Super-admin CRM and migrations. Bypasses RLS — never use for farm requests.
ADMIN_DATABASE_URL=postgres://admin_login:devpass@localhost:5433/rabbitry

PORT=3000
TRIAL_DAYS=30
NODE_ENV=development

# Shared secret for POST /scheduler/run. Netlify's scheduled function calls the
# runner directly and does not need it; this guards the HTTP trigger.
SCHEDULER_SECRET=change-me

# /scheduler/health reports unhealthy after this long with no successful run.
# Point an uptime monitor at it — that is the alerting.
SCHEDULER_STALE_SECONDS=3600
